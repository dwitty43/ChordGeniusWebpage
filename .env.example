# PostgreSQL Database URL (Railway, Supabase, Neon, Render, or local)
# Example: postgresql://username:password@localhost:5432/chordgenius
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chordgenius

# JWT Secret for User Authentication Tokens
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Spotify API Credentials (Optional: used for automatic BPM, Key, and Time Signature lookup)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Scraping API Keys (Optional: for bypassing Cloudflare on hosted servers)
USE_SCRAPING_API=false
ZENROWS_API_KEY=
SCRAPINGBEE_API_KEY=
